---
//
// Usage: <NoisyFrame> <div> ... </div> </NoisyFrame>
//
---

<noisy-frame>
    <canvas class="noise-frame-canvas"></canvas>
    <div class="slot-wrapper">
        <slot/>
    </div>
</noisy-frame>

<style>
    :root {
        --outline-width: 3px;
        --top-bleed: 20%;
    }

    noisy-frame {
        display: inline-block;
        position: relative;
        outline-width: var(--outline-width);
        border-radius: calc(var(--outline-width) * 4);
        background: transparent !important;
    }

    noisy-frame .noise-frame-canvas {
        position: absolute;
        z-index: 0;
        inset: 0;
        width: 100%;
        height: calc(100% + var(--top-bleed));
        top: calc(-1 * var(--top-bleed));
        pointer-events: none;
    }

    noisy-frame .slot-wrapper {
        position: relative;
        padding: calc(var(--outline-width) * 4);
    }
</style>

<script>
    import { NoisyFrame } from "./noisy_frame.ts";
    import { register } from "../common/register_component";
    register("noisy-frame", NoisyFrame);
</script>