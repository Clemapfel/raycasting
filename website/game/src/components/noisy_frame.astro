---
//
// Usage: <NoisyFrame> <div> ... </div> </NoisyFrame>
//
---

<noisy-frame>
    <canvas class="noise-frame-canvas"></canvas>
    <div class="slot-wrapper">
        <slot/>
    </div>
</noisy-frame>

<style>
    :root {
        --outline-width: 3px;
    }

    noisy-frame {
        display: inline-block;
        width: 100%;
        position: relative;
        outline-width: var(--outline-width);
        border-radius: calc(var(--outline-width) * 4);
        background: transparent !important;
    }

    /* Set --noisy-frame-background on this element or an ancestor to override the WebGL fill. */
    noisy-frame .noise-frame-canvas {
        position: absolute;
        z-index: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        filter: var(--noisy-frame-canvas-filter, none);
        transition: filter 150ms ease;
    }

    @media (prefers-reduced-motion: reduce) {
        noisy-frame .noise-frame-canvas {
            transition: none;
        }
    }

    noisy-frame .slot-wrapper {
        position: relative;
    }
</style>

<script>
    import { NoisyFrame } from "./noisy_frame.ts";
    import { register } from "../common/register_component";
    register("noisy-frame", NoisyFrame);
</script>