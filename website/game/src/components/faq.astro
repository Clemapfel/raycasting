---
interface Props { question: string, id: string }
const { question, id } = Astro.props;
---

<style>
    .faq {
        /* header question */
        --faq-header-font: var(--default-font), sans-serif;
        --faq-header-size: 1.25rem;
        --faq-header-color: var(--default-color-foreground);

        /* body */
        --faq-body-font: var(--default-font), sans-serif;
        --faq-body-size: 1rem;
        --faq-body-color: var(--default-color-foreground);

        /* icon */
        --faq-icon-size: 0.6em;
        --faq-icon-color: var(--default-color-foreground);

        /* link-target "selection" highlight */
        --faq-select-color: color-mix(in srgb, Highlight 55%, transparent);
        --faq-select-fade: 0.6s;

        margin-top: 2rem;
        scroll-margin-top: 2rem; /* raise if you have a fixed header */
    }

    .faq summary {
        font-family: var(--faq-header-font), sans-serif;
        font-size: var(--faq-header-size);
        color: var(--faq-header-color);
        font-weight: 600;
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.4em;
    }

    .faq summary:hover .faq-question {
        text-decoration: underline;
    }

    .faq summary::-webkit-details-marker {
        display: none;
    }

    .faq summary::before {
        content: "";
        flex: none;
        width: 0;
        height: 0;
        border-top: calc(var(--faq-icon-size) / 2) solid transparent;
        border-bottom: calc(var(--faq-icon-size) / 2) solid transparent;
        border-left: var(--faq-icon-size) solid var(--faq-icon-color);
        transition: transform 0.2s ease;
    }

    .faq[open] summary::before {
        transform: rotate(90deg);
    }

    .faq .faq-body {
        font-family: var(--faq-body-font), sans-serif;
        font-size: var(--faq-body-size);
        color: var(--faq-body-color);
        line-height: 1.6;
        margin: 0.75em 0 0 calc(var(--faq-icon-size) + 0.6em); /* aligns with header text */
    }

    /* selection-style highlight */
    .faq-question,
    .faq-body {
        background-color: transparent;
        border-radius: 2px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        transition: background-color var(--faq-select-fade) ease-out; /* fade out */
    }

    .faq-question {
        padding: 0.05em 0.2em;
        margin: -0.05em -0.2em;
    }

    .faq.faq-selected .faq-question,
    .faq.faq-selected .faq-body {
        background-color: var(--faq-select-color);
        transition: none; /* snap on like a real selection */
    }

    @media (prefers-reduced-motion: reduce) {
        .faq-question,
        .faq-body {
            transition: none;
        }
    }

    .faq-hline {
        margin: 2em 40px;
        border: none;
        height: 2px;
        border-radius: 999px;
        background-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );
        opacity: 80%;
    }

    .faq-question {
        padding: 0.05em 0.2em;
        margin: -0.05em -0.2em;
        border-radius: 2px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    .faq:target .faq-question {
        animation: faq-select 2s ease-out;
    }

    @keyframes faq-select {
        0%, 50% {
            background-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
            );
        }
        100%    { background-color: transparent; }
    }

    @media (prefers-reduced-motion: reduce) {
        .faq:target .faq-question {
            animation: none;
        }
    }
</style>

<details class="faq" id={id}>
    <summary><span class="faq-question">{question}</span></summary>
    <div class="faq-body"><slot /></div>
</details>
<hr class="faq-hline" />

<script>
    function openTarget() {
        const hash = decodeURIComponent(location.hash.slice(1));
        if (!hash) return;
        const el = document.getElementById(hash);
        if (el instanceof HTMLDetailsElement) {
            el.open = true;
            el.scrollIntoView();
        }
    }

    openTarget();
    window.addEventListener("hashchange", openTarget);
</script>