---
//
// Usage: <LanguageChooser orientation="horizontal" />
//
import { Locale, Translation } from "../i18n/translation.ts";
import BoxLayout from "./box_layout.astro";
import Tooltip from "./tooltip.astro";

interface Props {
    orientation?: "horizontal" | "vertical";
    tooltipPosition?: "top" | "right" | "bottom" | "left";
}

const { orientation = "horizontal", tooltipPosition = "top" } = Astro.props;

const current_locale = Astro.currentLocale;
const locale_order = [Locale.ENGLISH, Locale.GERMAN, Locale.JAPANESE];

const url = Astro.url;
const locale_regex = new RegExp(`^/(${locale_order.join("|")})(?=/|$|\\?|#)`);

const locale_to_href = Object.fromEntries(
    locale_order.map((locale) => {
        const next = new URL(url);
        next.pathname = next.pathname.replace(locale_regex, `/${locale}`);
        return [locale, next];
    })
) as Record<Locale, URL>;

const locale_icons: Record<Locale, string> = {
    [Locale.ENGLISH]: "🌐",
    [Locale.GERMAN]: "🇩🇪",
    [Locale.JAPANESE]: "🇯🇵",
};

const titles = Translation.language_chooser.title;
---

{current_locale !== undefined && (
<BoxLayout
        orientation={orientation}
        tooltipPosition={tooltipPosition}
        ariaLabel="Choose language"
>
    {locale_order.map((locale) => (
            <Tooltip text={titles[locale]} position={tooltipPosition}>
                <a
                        href={locale_to_href[locale]}
                        hreflang={locale}
                        lang={locale}
                        class:list={[
                            "language-chooser-item",
                            { current: locale === current_locale },
                        ]}
                        aria-label={titles[locale]}
                        aria-current={locale === current_locale ? "true" : undefined}
                >
                    <span class="box-layout-item-hover" aria-hidden="true"></span>
                    <span class="language-chooser-item-icon">
                        {locale_icons[locale]}
                    </span>
                </a>
            </Tooltip>
    ))}
</BoxLayout>
    )}

<style>
    .language-chooser-item {
        --language-chooser-icon-size: 30px;

        position: relative;
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: calc(1.5 * var(--language-chooser-icon-size));
        height: calc(1.5 * var(--language-chooser-icon-size));
        text-decoration: none !important;
    }

    .language-chooser-item-icon {
        position: relative;
        z-index: 1;
        display: block;
        font-family: var(--default-font), sans-serif;
        font-size: var(--language-chooser-icon-size);
        line-height: 1;
        text-align: center;
        user-select: none;
    }
</style>
