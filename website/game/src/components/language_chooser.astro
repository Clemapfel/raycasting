---
import { Locale, LanguageChooserTranslation } from "../i18n/translation.ts";

const current_locale = Astro.currentLocale;
const locale_order = [ Locale.ENGLISH, Locale.GERMAN, Locale.JAPANESE ];

const url = Astro.url;
const locale_regex = new RegExp(`^/(${locale_order.join("|")})(?=/|$|\\?|#)`);

const locale_to_href = Object.fromEntries(
    locale_order.map((locale) => {
        const next = new URL(url);
        next.pathname = next.pathname.replace(locale_regex, `/${locale}`);
        return [locale, next];
    })
) as Record<Locale, URL>;

const labels = LanguageChooserTranslation.label;
const titles = LanguageChooserTranslation.title;
---

{ current_locale !== undefined && (
/* render as [ foo | bar | ... | bat ] */
<div class="language-chooser">
    [
    { locale_order.map((locale, i) => [
        i > 0 && " | ",
        <a href={ locale_to_href[locale] } hreflang={ locale } lang={ locale } title={ titles[locale] }>
            { labels[locale] }
        </a>,
    ]) }
    ]
</div>
    ) }

<style>
    .language-chooser {
        /* float in the top-right corner of the viewport at all times */
        position: fixed;
        bottom: env(safe-area-inset-top, var(--global-outer-margin));
        right: env(safe-area-inset-right, var(--global-outer-margin));
        z-index: 1000;
        padding: 0.75rem 1rem;

        display: inline-flex;
        gap: 0.5em;
        align-items: baseline;

        font-size: 11.5pt;
        font-family: var(--default-font), sans-serif;
        color: var(--default-color-foreground);
        opacity: 50%;

        -webkit-text-stroke: 3px var(--default-color-background);
        paint-order: stroke fill;
    }

    .language-chooser:hover {
        opacity: 100%;
        transition: opacity 0.33s;
    }

    .language-chooser a {
        color: inherit;
        text-decoration: none;
    }

    .language-chooser a.current {
        text-decoration: underline;
    }

    .language-chooser a:hover {
        color: oklch(
            var(--global-color-l)
            var(--global-color-c)
            var(--global-color-h)
        );
    }
</style>