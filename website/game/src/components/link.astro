---
// usage: <Link text="text" href="https://link.com" />
// usage: <Link text="FAQ" href="faq#bug-report" applyLocale />
interface Props {
    text: string;
    href: string;
    class?: string;
    applyLocale?: boolean;
}

import { Locale } from "../i18n/translation.ts";
const { text, href, class: className, applyLocale = false } = Astro.props;

const locale = Astro.currentLocale ?? Locale.ENGLISH;
const localePath = href.replace(/^(\.{0,2}\/)+/, ""); // strip first 2 chars after /
const finalHref = applyLocale ? `/${locale}/${localePath}` : href;

const externalAttrs = applyLocale
    ? {}
    : { target: "_blank", rel: "noopener noreferrer" };
---

<a href={finalHref} {...externalAttrs} class={className}>
    <span class="label">{text}</span>
</a>

<style>
    a {
        --rainbow: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );

        text-decoration: underline dashed;
        text-decoration-color: var(--rainbow);
        text-underline-offset: 0.2em;

        color: var(--default-color-foreground);
        -webkit-text-fill-color: currentColor;
    }

    a:visited {
        color: var(--default-color-foreground);
    }

    a:hover {
        color: var(--rainbow);
        text-decoration-style: solid;
        text-decoration-color: var(--rainbow);
    }
</style>