---
// usage: <Link text="text" href="https://link.com" />
interface Props {
    text: string;
    href: string;
    class?: string;
}

const { text, href, class: className } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className}>
    <span class="label">{text}</span>
</a>

<style>
    a {
        --rainbow: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );

        text-decoration: underline dashed;
        text-decoration-color: var(--rainbow);
        text-underline-offset: 0.2em;

        color: var(--default-color-foreground);
        -webkit-text-fill-color: currentColor;
    }

    a:visited {
        color: var(--default-color-foreground);
    }

    a:hover {
        color: var(--rainbow);
        text-decoration-style: solid;
        text-decoration-color: var(--rainbow);
    }
</style>