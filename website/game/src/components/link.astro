---
// usage: <Link text="text" href="https://link.com" />
interface Props {
    text: string;
    href: string;
    class?: string;
}

const { text, href, class: className } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className}>
    <span class="label">{text}</span>
</a>

<style>
    a, a:hover
    {
        --link-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );
        color: var(--link-color);
        -webkit-text-fill-color: var(--link-color);
    }

    a:visited {
        text-decoration: underline dotted;
    }

    a:hover {
        text-decoration: underline;
    }
</style>