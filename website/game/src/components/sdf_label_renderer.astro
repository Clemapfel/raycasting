---
import { getEntry } from "astro:content";

interface Props {
    path: string;
}

const { path } = Astro.props;

if (!path) {
    throw new Error("In SDFLabelRenderer: `path` property not specified");
}
---

<sdf-label-renderer path={path}>
    <canvas class="sdf-label-renderer-canvas"></canvas>
</sdf-label-renderer>

<script>
    import { SDFLabelRenderer } from "./sdf_label_renderer";
    import { register } from "../common/register_component.ts"
    register("sdf-label-renderer", SDFLabelRenderer)
</script>