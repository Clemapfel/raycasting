---
//
// Usage: <SDFLabelRenderer path="/image.png"/>
//

import { getEntry } from "astro:content";

interface Props {
    path: string;
}

const { path } = Astro.props;

if (!path) {
    throw new Error("In SDFLabelRenderer: `path` property not specified");
}
---

<sdf-label-renderer path={path}>
    <canvas class="sdf-label-renderer-canvas"></canvas>
</sdf-label-renderer>

<style>
    sdf-label-renderer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -9999;
        background: rgba(0, 0, 0, 1) !important;
        pointer-events: none;
    }

    .sdf-label-renderer {
        position: fixed;
        top: 0;
        left: 0;
    }
</style>

<script>
    import { SDFLabelRenderer } from "./sdf_label_renderer";
    import { register } from "../common/register_component.ts"
    register("sdf-label-renderer", SDFLabelRenderer)
</script>