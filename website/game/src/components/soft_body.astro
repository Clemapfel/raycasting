yy---
//
// Usage: <SoftBody id="shader_id"/>
//
---

<soft-body>
    <canvas class="soft-body-canvas"></canvas>
</soft-body>

<style>
    soft-body {
        --soft-body-width: 100%;
        --soft-body-height: 100%;

        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgb(0, 0, 0, 0) !important;
        color: oklch(
            var(--global-color-l)
            var(--global-color-c)
            var(--global-color-h)
        );
        pointer-events: none;
    }

    .soft-body-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--soft-body-width);
        height: var(--soft-body-height);
        pointer-events: none; /* manually connected in shader_canvas.ts */
    }
</style>

<script>
    import { SoftBody } from "./soft_body";
    import { register } from "../common/register_component.ts"
    register("soft-body", SoftBody)
</script>