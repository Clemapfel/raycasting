---
// components/header_bar.astro
import LabelSDF from "./label_sdf.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locale = Astro.currentLocale;

const items = [
    { name: "home" },
    { name: "about" },
    { name: "faq" },
    { name: "contact" },
    { name: "blog" },
].map(({ name }) => ({
    name,
    href: `${base}/${locale}/${name}`,
    sdfPath: `/${name}.png`,
}))
---

<style>
    .header-bar {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-left: 20%;
        margin-right: 20%;
    }

    .sdf-label-renderer-wrapper {
        display: contents;
        --margin-horizontal: 20px;
        margin-left: var(--margin-horizontal);
        margin-right: var(--margin-horizontal);
    }
</style>

<nav class="header-bar">
    {
        items.map((item) => (
            <div class="sdf-label-renderer-wrapper">
                <LabelSDF path={item.sdfPath} blur="false" />
            </div>
        ))
    }
</nav>