---
// components/header_bar.astro
import SDFLabelRenderer from "./sdf_label_renderer.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locale = Astro.currentLocale;

const items = [
    { name: "home" },
    { name: "about" },
    { name: "faq" },
    { name: "contact" },
    { name: "blog" },
].map(({ name }) => ({
    name,
    href: `${base}/${locale}/${name}`,
    sdfPath: `/${name}.png`,
}));
---

<style>
    .header-bar {
        position: relative;
        z-index: 10; /* stay above the shader canvas */
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding: 1rem;
    }

    .header-item {
        display: block;
        position: relative;
        flex: 0 0 auto;
        width: 100%;
        height: 10rem;
    }

    .header-item :global(sdf-label-renderer) {
        display: block;
        position: relative;
        width: 100%;
        height: 100%;
    }

    .header-item :global(canvas) {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
</style>

<nav class="header-bar">
    {
        items.map((item) => (
                <a class="header-item" href={item.href}>
                    <SDFLabelRenderer path={item.sdfPath} />
                </a>
        ))
    }
</nav>