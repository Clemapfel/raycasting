---
// components/header_bar.astro
import LabelSDF from "./label_sdf.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locale = Astro.currentLocale;

const items = [
    { name: "home" },
    { name: "about" },
    { name: "contact" },
    { name: "blog" },
].map(({ name }) => ({
    name,
    href: `${base}/${locale}/${name}`,
    sdfPath: `/${name}.png`,
}))
---

<style>
    .header-bar {
        display: flex;
        position: relative;
        isolation: isolate;
    }

    .label-sdf-wrapper {
        display: contents;
        height: 8rem;
        cursor: pointer;
        color: oklch(
            var(--global-color-l)
            var(--global-color-c)
            var(--global-color-h)
        );
    }
</style>

<nav class="header-bar">
    {
        items.map((item) => (
            <a href={item.href} class="label-sdf-wrapper">
                <LabelSDF path={item.sdfPath} blur={true} />
            </a>
        ))
    }
</nav>