---
// components/header_bar.astro
import LabelSDF from "./label_sdf.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locale = Astro.currentLocale;

// map identical pictures
const mapping : Readonly<Record<string, string>> = {
    "faq_de" :  "faq_en",
    "blog_de" : "blog_en",
    "faq_ja" : "faq_en"
};

const items = [
    { name: "home" },
    { name: "about" },
    { name: "faq" },
    { name: "contact" },
    { name: "blog" },
].map(({ name }) => {
    const raw = `${name}_${locale}`;
    const file = mapping[raw] ?? raw;
    return {
        name,
        href: `${base}/${locale}/${name}`,
        sdfPath: `/${file}.png`,
    };
});
---

<style>
    .header-bar {
        display: flex;
        position: relative;
        isolation: isolate;
        gap: 2rem;
    }

    .label-sdf-wrapper {
        display: contents;
        height: 8rem;
        cursor: pointer;
        color: oklch(
            var(--global-color-l)
            var(--global-color-c)
            var(--global-color-h)
        );
    }
</style>

<nav class="header-bar">
    {
        items.map((item) => (
            <a href={item.href} class="label-sdf-wrapper">
                <LabelSDF path={item.sdfPath} blur={true} reactive={true} />
            </a>
        ))
    }
</nav>