---
// components/header_bar.astro

import LabelSDF from "./label_sdf.astro";
import { Locale, Translation } from "../i18n/translation.ts";

const NAV_ITEMS = ["home", "about", "faq", "contact", "posts"] as const;
type NavItem = (typeof NAV_ITEMS)[number];

interface Props {
    items?: readonly NavItem[];
}

const { items: enabled = NAV_ITEMS } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locale = Astro.currentLocale ?? Locale.ENGLISH;

const mapping: Readonly<Record<string, string>> = {
    "header_bar/faq_de": "header_bar/faq_en",
    "header_bar/posts_de": "header_bar/posts_en",
    "header_bar/faq_ja": "header_bar/faq_en",
};

const titles = Translation.header_bar.title;
const enabledSet = new Set<string>(enabled);

const items = NAV_ITEMS
    .filter((name) => enabledSet.has(name))
    .map((name) => {
        const raw = `header_bar/${name}_${locale}`;
        const file = mapping[raw] ?? raw;
        const title = titles[name][locale];

        return {
            name,
            href: `${base}/${locale}/${name}`,
            sdfPath: `/${file}.png`,
            title,
        };
    });
---

<style>
    .header-bar {
        display: flex;
        position: relative;
        isolation: isolate;
        gap: 2rem;
    }

    .label-sdf-wrapper {
        display: contents;
        height: 8rem;
        cursor: pointer;
        color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );
    }
</style>

<nav class="header-bar">
    {
        items.map((item) => (
                <a href={ item.href } class="label-sdf-wrapper" title={ item.title }>
                    <LabelSDF path={ item.sdfPath } blur={ true } reactive={ true } />
                </a>
        ))
    }
</nav>