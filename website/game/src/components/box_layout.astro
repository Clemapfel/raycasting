---

interface Props {
    orientation?: "horizontal" | "vertical";
    tooltipPosition?: "top" | "right" | "bottom" | "left";
    itemsPerLine?: number;
    ariaLabel?: string;
}

const {
    orientation = "horizontal",
    tooltipPosition = "top",
    itemsPerLine = 1,
    ariaLabel,
} = Astro.props;

const outlineWidth = "2px";
const dividerWidth = "2px";

const horizontal = orientation === "horizontal";
const lineSize = Math.max(1, Math.floor(itemsPerLine));

const afterFirstLine = `:nth-child(n + ${lineSize + 1})`;
const notFirstInLine = `:not(:nth-child(${lineSize}n + 1))`;
const [dividerAbove, dividerBefore] = horizontal
    ? [notFirstInLine, afterFirstLine]
    : [afterFirstLine, notFirstInLine];

const scope = `.box-layout${horizontal ? ".horizontal" : ":not(.horizontal)"}[data-items-per-line="${lineSize}"]`;
const dividerCss = `
${scope} > ${dividerAbove} { --divider-block: var(--divider-width); }
${scope} > ${dividerBefore} { --divider-inline: var(--divider-width); }
`;
---

<nav
        class:list={["box-layout", { horizontal }]}
        style={{
            "--items-per-line": lineSize,
            "--outline-width": outlineWidth,
            "--divider-width": dividerWidth,
        }}
        data-items-per-line={lineSize}
        aria-label={ariaLabel}
>
    <slot />
</nav>
<style is:inline set:html={dividerCss}></style>

<style>
    .box-layout {
        --divider-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );

        z-index: 1000;
        display: inline-grid;
        grid-auto-flow: row;
        grid-template-columns: repeat(var(--items-per-line), 1fr);
        border: var(--outline-width) solid var(--divider-color);
        border-radius: 8px;
        background: var(--default-color-background);
        opacity: 0.5;
        transition: opacity 0.3s ease;
    }

    .box-layout.horizontal {
        grid-auto-flow: column;
        grid-template-columns: none;
        grid-template-rows: repeat(var(--items-per-line), 1fr);
    }

    .box-layout:hover {
        opacity: 1;
    }

    .box-layout :global(.box-layout-item-hover) {
        position: absolute;
        inset: 4px;
        border-radius: 8px;
        background: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h) / 0.25
        );
        opacity: 0;
        transition: opacity 0.2s ease;
        pointer-events: none;
    }

    .box-layout :global(.current .box-layout-item-hover),
    .box-layout :global(a:is(:hover, :focus-visible) .box-layout-item-hover) {
        opacity: 1;
    }

    .box-layout > :global(*:not(:first-child)),
    .box-layout :global(.tooltip:not(:first-child) :is(a, button, [role="button"])) {
        position: relative;
    }

    .box-layout > :global(*:not(:first-child))::before,
    .box-layout :global(.tooltip:not(:first-child) :is(a, button, [role="button"]))::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background:
                linear-gradient(var(--divider-color), var(--divider-color))
                center top / calc(100% - 16px) var(--divider-block, 0px) no-repeat,
                linear-gradient(var(--divider-color), var(--divider-color))
                left center / var(--divider-inline, 0px) calc(100% - 16px) no-repeat;
    }
</style>