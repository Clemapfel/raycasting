---
//
// Usage: <PlayPauseButton />
//
---

<animation-state-button>
    <button type="button" aria-pressed="false" aria-label="Pause animations">
        <span class="icon-pause" aria-hidden="true"></span>
        <span class="icon-play" aria-hidden="true"></span>
    </button>
</animation-state-button>

<style>
    animation-state-button button {
            --toggle-hover-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );

        position: fixed;
        left: 10px;
        bottom: 10px;
        z-index: 9999;
        width: 36px;
        height: 36px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--toggle-hover-color);
        background: var(--default-color-background);
        border-color: var(--toggle-hover-color);
        border-width: 2px;
        border-style: solid;
        border-radius: 50%;
        cursor: pointer;
        opacity: 0.3;
        transition: opacity 0.15s ease, color 0.15s ease;
        pointer-events: auto;
    }

    animation-state-button button:hover,
    animation-state-button button:focus-visible {
        opacity: 1;
    }

    animation-state-button .icon-pause,
    animation-state-button .icon-play {
        position: relative;
        width: 18px;
        height: 18px;
    }

    animation-state-button .icon-pause::before,
    animation-state-button .icon-pause::after {
        content: "";
        position: absolute;
        top: 3.75px;
        width: 3px;
        height: 10.5px;
        border-radius: 0.75px;
        background: currentColor;
    }

    animation-state-button .icon-pause::before {
        left: 4.5px;
    }

    animation-state-button .icon-pause::after {
        left: 10.5px;
    }

    animation-state-button .icon-play {
        display: none;
        background: currentColor;

        --s: 14px;
        --h: calc(var(--s) * sqrt(3) / 2);

        clip-path: polygon(
            calc(50% - var(--h) / 3) calc(50% - var(--s) / 2),
            calc(50% - var(--h) / 3) calc(50% + var(--s) / 2),
            calc(50% + var(--h) * 2 / 3)  50%
        );

        margin-left: calc(-1 * sqrt(3) / 3 / 4 * var(--s))
    }

    animation-state-button button[aria-pressed="true"] .icon-pause {
        display: none;
    }

    animation-state-button button[aria-pressed="true"] .icon-play {
        display: block;
    }
</style>

<script>
    import { AnimationStateButton } from "./animation_state_button.ts";
    import { register } from "../common/register_component";
    register("animation-state-button", AnimationStateButton);
</script>