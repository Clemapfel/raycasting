---
//
// Usage: <AnimationStateButton />
//

import Tooltip from "./tooltip.astro";
import { Locale, AnimationStateButtonTranslation } from "../i18n/translation";
---

<animation-state-button>
    <button
            class="animation-state-button-item"
            type="button"
            aria-pressed="false"
    >
        <span class="box-layout-item-hover" aria-hidden="true"></span>
        <span class="icon-pause" aria-hidden="true"></span>
        <span class="icon-play" aria-hidden="true"></span>
    </button>
</animation-state-button>

<style>
    animation-state-button {
        display: inline-block;
    }

    animation-state-button .animation-state-button-item {
        --toggle-hover-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );

        position: relative;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 45px;
        height: 45px;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--toggle-hover-color);
        cursor: pointer;
        opacity: 0.5;
        transition: opacity 0.15s ease, color 0.15s ease;
        pointer-events: auto;
    }

    animation-state-button .animation-state-button-item:hover,
    animation-state-button .animation-state-button-item:focus-visible {
        opacity: 1;
    }

    animation-state-button .icon-pause,
    animation-state-button .icon-play {
        position: relative;
        z-index: 1;
        width: 18px;
        height: 18px;
    }

    animation-state-button .icon-pause::before,
    animation-state-button .icon-pause::after {
        content: "";
        position: absolute;
        top: 3.75px;
        width: 3px;
        height: 10.5px;
        border-radius: 0.75px;
        background: currentColor;
    }

    animation-state-button .icon-pause::before {
        left: 4.5px;
    }

    animation-state-button .icon-pause::after {
        left: 10.5px;
    }

    animation-state-button .icon-play {
        display: none;
        background: currentColor;

        --triangle-base: 14px;
        --triangle_height: calc(var(--triangle-base) * sqrt(3) / 2);

        clip-path: polygon(
                calc(50% - var(--triangle_height) / 3) calc(50% - var(--triangle-base) / 2),
                calc(50% - var(--triangle_height) / 3) calc(50% + var(--triangle-base) / 2),
                calc(50% + var(--triangle_height) * 2 / 3) 50%
        );

        margin-left: calc(-1 * sqrt(3) / 3 / 4 * var(--triangle-base));
    }

    animation-state-button button[aria-pressed="true"] .icon-pause {
        display: none;
    }

    animation-state-button button[aria-pressed="true"] .icon-play {
        display: block;
    }
</style>

<script>
    import { AnimationStateButton } from "./animation_state_button.ts";
    import { register } from "../common/register_component";

    register("animation-state-button", AnimationStateButton);
</script>
