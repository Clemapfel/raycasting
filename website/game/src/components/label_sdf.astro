---
// Usage: <LabelSDF path="path/to/sdf.png" blur={false} />

import { getEntry } from "astro:content";

interface Props {
    path: string;
    blur?: boolean;
}

const { path, blur = false } = Astro.props;

if (!path) {
    throw new Error("In LabelSDF: `path` property not specified");
}
---

<style>
    .label-sdf-canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    .label-sdf {
        color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );
    }
</style>

<label-sdf path={path} blur={blur}>
    <canvas class="label-sdf-canvas"></canvas>
</label-sdf>

<script>
    import { LabelSDF } from "./label_sdf";
    import { register } from "../common/register_component.ts"
    register("label-sdf", LabelSDF)
</script>