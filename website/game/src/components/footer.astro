---
//
// Usage: <Footer author="Jim Bobbins"/>
//

import Link from "./link.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

const currentYear = new Date().getFullYear();

const translations = {
    en: {
        legalNoticeText: "All rights reserved",
        aiNoticeText: "This page contains no AI-generated content",
        legalNoticeRef: "Legal Notice",
        legalNoticeSlug: "legal-notice"
    },
    de: {
        legalNoticeText: "Alle Rechte vorbehalten",
        aiNoticeText: "Diese Seite enthält keine KI-erstellte Inhalte",
        legalNoticeRef: "Impressum",
        legalNoticeSlug: "impressum"
    },

    ja: {
        legalNoticeText: "TODO",
        aiNoticeText: "TODO",
        legalNoticeRef: "TODO",
        legalNoticeSlug: "legal-notice"
    },
} as const;

type Locale = keyof typeof translations;

const locale: Locale =
    Astro.currentLocale && Astro.currentLocale in translations
        ? (Astro.currentLocale as Locale)
        : "en";

const {
    legalNoticeText,
    aiNoticeText,
    legalNoticeRef,
    legalNoticeSlug
} = translations[locale];

const legalNoticeLink = `/${locale}/${legalNoticeSlug}`;
---

<style>
    footer {
        position: relative; /* makes z-index effective so nothing overlaps the hover area */
        z-index: 1;
        margin-top: auto;
        padding: 1rem;
        font-family: var(--default-font), sans-serif;
        color: var(--default-color-foreground);
        -webkit-text-stroke: 3px var(--default-color-background);
        -webkit-text-fill-color: currentColor;
        paint-order: stroke fill;
        text-align: center;
        opacity: 0.5;
        transition: opacity 0.33s;
    }

    footer:hover {
        opacity: 1
    }

    /* override styling of Link */
    footer :global(a:not(:hover)) {
        color: var(--default-color-foreground) !important;
        -webkit-text-fill-color: var(--default-color-foreground) !important;
        text-decoration-color: var(--default-color-foreground) !important;
    }
</style>

<footer>
    <p>
        &copy; {currentYear} {legalNoticeText} | <Link text={legalNoticeRef} href={legalNoticeLink} /> | {aiNoticeText}
    </p>
</footer>