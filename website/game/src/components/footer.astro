---
//
// Usage: <Footer author="Jim Bobbins"/>
//

import Link from "./link.astro";
import { Locale, Translation } from "../i18n/translation";
import { getRelativeLocaleUrl } from "astro:i18n";

const current_year = new Date().getFullYear();

const local_to_slug = {
    [Locale.ENGLISH] : "legal-notice",
    [Locale.GERMAN] : "impressum",
    [Locale.JAPANESE] : "legal-notice"
}

const locale = Astro.currentLocale ?? Locale.ENGLISH;

const rights = Translation.footer.rights[locale];
const legal_notice = Translation.footer.legal_notice[locale];
const ai_policy = Translation.footer.ai_policy[locale];

const legal_notice_url = `/${locale}/${local_to_slug[locale]}`;
---

<style>
    footer {
        position: relative; /* makes z-index effective so nothing overlaps the hover area */
        z-index: 1;
        margin-top: auto;
        padding: 1rem;
        font-family: var(--default-font), sans-serif;
        color: var(--default-color-foreground);
        -webkit-text-stroke: 3px var(--default-color-background);
        -webkit-text-fill-color: currentColor;
        paint-order: stroke fill;
        text-align: center;
        opacity: 0.5;
        transition: opacity 0.33s;
    }

    footer:hover {
        opacity: 1
    }

    /* override styling of Link */
    footer :global(a:not(:hover)) {
        color: var(--default-color-foreground) !important;
        -webkit-text-fill-color: var(--default-color-foreground) !important;
        text-decoration-color: var(--default-color-foreground) !important;
    }
</style>

<footer>
    <p>
        &copy; {current_year} {rights} | <Link text={legal_notice} href={legal_notice_url} /> | {ai_policy}
    </p>
</footer>