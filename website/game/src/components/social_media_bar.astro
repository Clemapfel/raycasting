---
import Tooltip from "./tooltip.astro";

enum SocialMediaPlatform {
    BLUESKY = "bluesky",
    TWITTER = "twitter",
    INSTAGRAM = "instagram",
    TIKTOK = "tiktok",
    YOUTUBE = "youtube",
    DISCORD = "discord",
    KICKSTARTER = "kickstarter"
}

const platform_to_entry = {
    [SocialMediaPlatform.BLUESKY]: {
        title: "Bluesky",
        href: "https://bsky.app/profile/YOUR_HANDLE.bsky.social"
    },
    [SocialMediaPlatform.DISCORD]: {
        title: "Discord",
        href: "https://discord.gg/YOUR_INVITE_CODE"
    },
    [SocialMediaPlatform.TWITTER]: {
        title: "Twitter",
        href: "https://x.com/YOUR_HANDLE"
    },
    [SocialMediaPlatform.INSTAGRAM]: {
        title: "Instagram",
        href: "https://www.instagram.com/YOUR_HANDLE"
    },
    [SocialMediaPlatform.YOUTUBE]: {
        title: "YouTube",
        href: "https://www.youtube.com/@YOUR_HANDLE"
    },
    [SocialMediaPlatform.KICKSTARTER]: {
        title: "Kickstarter",
        href: "https://www.kickstarter.com/projects/YOUR_CREATOR/YOUR_PROJECT"
    },
    [SocialMediaPlatform.TIKTOK]: {
        title: "TikTok",
        href: "https://www.tiktok.com/@YOUR_HANDLE"
    }
};
---

<nav class="social-media-bar">
    {Object.entries(platform_to_entry).map(([platform, entry]) => (
            <Tooltip text={entry.title}>
                <a
                        href={entry.href}
                        class="social-media-bar-item"
                        aria-label={entry.title}
                        target="_blank"
                        rel="noopener noreferrer"
                >
                    <span class="social-media-bar-item-hover" aria-hidden="true"></span>
                    <img src={`/socials_${platform}.svg`} alt={entry.title} />
                </a>
            </Tooltip>
    ))}
</nav>

<style>
    :root {
        --social-media-bar-icon-size:  30px;
    }

    .social-media-bar {
        display: inline-flex;
        flex-direction: column;
        border: 1px solid oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );
        border-radius: 8px;
        background: var(--default-color-background);
        opacity: 0.75;
        transition: opacity 0.3s ease;
    }

    .social-media-bar:hover,
    .social-media-bar:focus-within {
        opacity: 1;
    }

    .social-media-bar-item {
        flex-shrink: 0;
        position: relative;
        display: grid;
        place-items: center;
        width: calc(1.5 * var(--social-media-bar-icon-size));
        height: calc(1.5 * var(--social-media-bar-icon-size));
    }

    :global(.tooltip:not(:first-child)) .social-media-bar-item::before {
        content: "";
        position: absolute;
        top: 0;
        left: 8px;
        right: 8px;
        height: 1px;
        z-index: 2;
        background: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );
    }

    .social-media-bar-item img {
        position: relative;
        z-index: 1;
        display: block;
        width: var(--social-media-bar-icon-size);
        height: var(--social-media-bar-icon-size);
        object-fit: contain;
    }

    .social-media-bar-item-hover {
        position: absolute;
        inset: 4px;
        border-radius: 8px;
        background: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
                / 0.25
        );
        opacity: 0;
        transition: opacity 0.2s ease;
        pointer-events: none;
    }

    .social-media-bar-item:hover .social-media-bar-item-hover,
    .social-media-bar-item:focus-visible .social-media-bar-item-hover {
        opacity: 1;
    }
</style>