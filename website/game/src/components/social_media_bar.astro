---
//
// Usage <SocialMediaBar orientation="horizontal" />
//

import BoxLayout from "./box_layout.astro";
import Tooltip from "./tooltip.astro";

interface Props {
    orientation?: "horizontal" | "vertical";
    tooltipPosition?: "top" | "right" | "bottom" | "left";
}

const { orientation = "horizontal", tooltipPosition = "top" } = Astro.props;

enum SocialMediaPlatform {
    BLUESKY = "bluesky",
    TWITTER = "twitter",
    INSTAGRAM = "instagram",
    TIKTOK = "tiktok",
    YOUTUBE = "youtube",
    DISCORD = "discord",
    KICKSTARTER = "kickstarter",
    GITHUB = "github",
}

const platform_to_entry = {
    [SocialMediaPlatform.BLUESKY]: {
        title: "Bluesky",
        href: "https://bsky.app/profile/chromavoid.bsky.social",
    },

    [SocialMediaPlatform.DISCORD]: {
        title: "Discord",
        href: "https://discord.com/users/1564781745579229347",
    },

    [SocialMediaPlatform.TWITTER]: {
        title: "Twitter",
        href: "https://twitter.com/ch",
    },

    [SocialMediaPlatform.INSTAGRAM]: {
        title: "Instagram",
        href: "https://www.instagram.com/TODO",
    },

    [SocialMediaPlatform.YOUTUBE]: {
        title: "YouTube",
        href: "https://www.youtube.com/@TODO",
    },

    [SocialMediaPlatform.KICKSTARTER]: {
        title: "Kickstarter",
        href: "https://www.kickstarter.com/projects/YOUR_CREATOR/YOUR_PROJECT",
    },

    [SocialMediaPlatform.TIKTOK]: {
        title: "TikTok",
        href: "https://www.tiktok.com/@TODO",
    },

    [SocialMediaPlatform.GITHUB]: {
        title: "GitHub",
        href: "https://www.github.com/@TODO",
    },
};
---

<BoxLayout orientation={orientation} tooltipPosition={tooltipPosition}>
    {Object.entries(platform_to_entry).map(([platform, entry]) => (
            <Tooltip text={entry.title} orientation={tooltipPosition}>
                <a
                        href={entry.href}
                        class="social-media-bar-item"
                        aria-label={entry.title}
                        target="_blank"
                        rel="noopener noreferrer"
                >
                    <span class="box-layout-item-hover" aria-hidden="true"></span>
                    <img src={`/socials/${platform}.svg`} alt={entry.title} />
                </a>
            </Tooltip>
    ))}
</BoxLayout>

<style>
    .social-media-bar-item {
        --social-media-bar-icon-size: 30px;

        flex-shrink: 0;
        position: relative;
        display: grid;
        place-items: center;
        width: calc(1.5 * var(--social-media-bar-icon-size));
        height: calc(1.5 * var(--social-media-bar-icon-size));
    }

    .social-media-bar-item img {
        position: relative;
        z-index: 1;
        display: block;
        width: var(--social-media-bar-icon-size);
        height: var(--social-media-bar-icon-size);
        object-fit: contain;
    }
</style>
