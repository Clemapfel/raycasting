yy---
//
// Usage: <ShaderCanvas id="shader_id"/>
//

import { getEntry } from "astro:content";

interface Props {
    id: string;
}

const { id } = Astro.props;

if (!id) {
    throw new Error("In ShaderCanvas: `id` property not specified");
}

const fragment_shader_entry = await getEntry("shaders", id);
const fragment_shader = fragment_shader_entry?.body;

if (!fragment_shader) {
    throw new Error(`FragmentShader not found: ${id}`);
}
---

<shader-canvas fragment-shader-source={fragment_shader}>
    <canvas class="shader-canvas-canvas"></canvas>
</shader-canvas>

<button class="shader-canvas-toggle" type="button" aria-label="Pause shader" aria-pressed="false">
    <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <rect x="6" y="5" width="4" height="14" rx="1"/>
        <rect x="14" y="5" width="4" height="14" rx="1"/>
    </svg>
    <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"/>
    </svg>
</button>

<style>
    shader-canvas {
        --shader-canvas-width: 100%;
        --shader-canvas-height: 100%;

        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -9999;
        background: rgba(0, 0, 0, 1) !important;
        pointer-events: none;
    }

    .shader-canvas-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--shader-canvas-width);
        height: var(--shader-canvas-height);
        pointer-events: none; /* manually connected in shader_canvas.ts */
    }

    .shader-canvas-toggle {
        --toggle-hover-color: oklch(
                var(--global-color-l)
                var(--global-color-c)
                var(--global-color-h)
        );

        position: fixed;
        left: 10px;
        bottom: 10px;
        z-index: 9999;
        width: 36px;
        height: 36px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--toggle-hover-color);
        background: var(--default-color-background);
        border-color: var(--toggle-hover-color);
        border-width: 2px;
        border-style: solid;
        border-radius: 50%;
        cursor: pointer;
        opacity: 0.3;
        transition: opacity 0.15s ease, color 0.15s ease;
        pointer-events: auto;
    }

    .shader-canvas-toggle:hover,
    .shader-canvas-toggle:focus-visible {
        opacity: 1;
    }

    .shader-canvas-toggle .icon-play { display: none; }
    .shader-canvas-toggle[aria-pressed="true"] .icon-pause { display: none; }
    .shader-canvas-toggle[aria-pressed="true"] .icon-play { display: block; }
</style>

<script>
    import { ShaderCanvas } from "./shader_canvas.ts";
    import { register } from "../common/register_component.ts"
    register("shader-canvas", ShaderCanvas)

    document.querySelectorAll<HTMLButtonElement>(".shader-canvas-toggle").forEach((button) => {
        const canvas = button.previousElementSibling;
        if (!canvas) return;

        button.addEventListener("click", async () => {
            await customElements.whenDefined("shader-canvas");
            const shader_canvas = canvas as unknown as ShaderCanvas;
            const paused = !shader_canvas.getIsPaused();
            shader_canvas.setIsPaused(paused);
            button.setAttribute("aria-pressed", String(paused));
            button.setAttribute("aria-label", paused ? "Play shader" : "Pause shader");
        });
    });
</script>