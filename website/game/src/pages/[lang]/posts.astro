---
import { getCollection, getEntry } from "astro:content";
import ContentLayout from "../../layouts/content_layout.astro";
import { Locale, Translation } from "../../i18n/translation.ts";
import NoisyFrame from "../../components/noisy_frame.astro";
import PostThumbnail from "../../components/post_thumbnail.astro";
import BoxLayout from "../../components/box_layout.astro";
import Tooltip from "../../components/tooltip.astro";
import MarkdownRenderer from "../../components/markdown.astro";

export async function getStaticPaths() {
    return Object.values(Locale).map((lang) => ({
        params: { lang: lang },
    }));
}

const page_local = Astro.currentLocale ?? Locale.ENGLISH;

const labels = {
    prefix: Translation.posts.sort_by[page_local],
    newest: Translation.posts.newest[page_local],
    oldest: Translation.posts.oldest[page_local],
    alphabetical: Translation.posts.alphabetical[page_local],
};

enum SortMode {
    NEWEST_FIRST = "NEWEST_FIRST",
    OLDEST_FIRST = "OLDEST_FIRST",
    ALPHABETICAL = "ALPHABETICAL",
}

const sortModes = Object.values(SortMode);
const initialSortMode = SortMode.NEWEST_FIRST;

const posts = (
    await getCollection("posts", ({ data }) =>
        page_local === Locale.ENGLISH
            ? data.locale === Locale.ENGLISH
            : data.locale === page_local || data.locale === Locale.ENGLISH
    )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());


const shader = (await getEntry("pages", "posts"))?.data.shader;
---

<style>
    .posts-area {
        position: relative;
        width: 100%;
    }

    .sort-button {
        position: relative;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--default-color-foreground);
        cursor: pointer;
        transition: none !important;
    }

    .sort-button svg {
        position: relative;
        z-index: 1;
        width: 20px;
        height: 20px;
        stroke: oklch(
            var(--global-color-l)
            var(--global-color-c)
            var(--global-color-h)
        );
    }

    .sort-button:focus-visible {
        outline: 2px solid var(--default-color-foreground);
        outline-offset: 2px;
    }

    .intro-tile {
        width: 100%;
        margin-bottom: 40px;
    }

    .intro-content {
        padding: 20px 40px;
    }

    .posts {
        --masonry-row: 1px;
        --masonry-gap: 40px;

        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-auto-rows: var(--masonry-row);
        grid-auto-flow: row;

        column-gap: var(--masonry-gap);
        row-gap: 0;

        width: 100%;
        box-sizing: border-box;
        padding: 0;
    }

    .post-tile {
        min-width: 0;
        align-self: start;
        grid-row-end: span 1;
    }

    .tile-content {
        padding: 20px;
    }

    .post-tile:hover {
        --noisy-frame-canvas-filter: brightness(1.5);
    }

    @media (max-width: 900px) {
        .posts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .posts {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<ContentLayout shader={shader}>
    <div
            slot="top-controls"
            class="sort-control"
    >
        <Tooltip text={labels.newest} position="left">
            <BoxLayout orientation="vertical">
                <button
                        type="button"
                        class="sort-button"
                        id="sort-button"
                        data-order={initialSortMode}
                        data-sort-modes={JSON.stringify(sortModes)}
                        data-locale={page_local}
                        data-prefix={labels.prefix}
                        data-newest={labels.newest}
                        data-oldest={labels.oldest}
                        data-alphabetical={labels.alphabetical}
                        aria-label={`${labels.prefix} ${labels.newest}`}
                >
                    <span class="box-layout-item-hover"></span>
                    <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="m3 16 4 4 4-4" />
                        <path d="M7 20V4" />
                        <path d="M11 4h10" />
                        <path d="M11 8h7" />
                        <path d="M11 12h4" />
                    </svg>
                </button>
            </BoxLayout>
        </Tooltip>
    </div>

    <div class="posts-area">
        <div class="intro-tile">
            <NoisyFrame>
                <div class="intro-content">
                    <MarkdownRenderer collection="pages" id="posts" />
                </div>
            </NoisyFrame>
        </div>

        <div class="posts-wrapper">
            <div
                    class="posts"
                    id="posts"
                    role="list"
                    aria-label="Posts"
            >
                {posts.map((post) => (
                        <div
                                class="post-tile"
                                role="listitem"
                                data-date={post.data.date.valueOf()}
                                data-title={post.data.title}
                        >
                            <NoisyFrame>
                                <div class="tile-content">
                                    <PostThumbnail post={post} />
                                </div>
                            </NoisyFrame>
                        </div>
                ))}
            </div>
        </div>
    </div>
</ContentLayout>

<script>
    const button = document.getElementById(
        "sort-button"
    ) as HTMLButtonElement | null;

    const container = document.getElementById("posts");
    const tooltip = button?.closest(".sort-control")?.querySelector<HTMLElement>(
        ".tooltip-bubble"
    );

    if (button && container) {
        type SortMode =
            | "NEWEST_FIRST"
            | "OLDEST_FIRST"
            | "ALPHABETICAL";

        const sortModes = JSON.parse(
            button.dataset.sortModes ?? "[]"
        ) as SortMode[];

        const modeLabels: Record<SortMode, string> = {
            NEWEST_FIRST: button.dataset.newest ?? "",
            OLDEST_FIRST: button.dataset.oldest ?? "",
            ALPHABETICAL: button.dataset.alphabetical ?? "",
        };

        const collator = new Intl.Collator(
            button.dataset.locale ?? undefined
        );

        const comparators: Record<
            SortMode,
            (a: HTMLElement, b: HTMLElement) => number
        > = {
            NEWEST_FIRST: (a, b) =>
                Number(b.dataset.date) - Number(a.dataset.date),

            OLDEST_FIRST: (a, b) =>
                Number(a.dataset.date) - Number(b.dataset.date),

            ALPHABETICAL: (a, b) =>
                collator.compare(
                    a.dataset.title ?? "",
                    b.dataset.title ?? ""
                ),
        };

        const tiles = Array.from(
            container.querySelectorAll<HTMLElement>(".post-tile")
        );

        let layoutFrame = 0;

        const updateMasonryLayout = () => {
            const styles = getComputedStyle(container);

            const rowSize =
                Number.parseFloat(
                    styles.getPropertyValue("--masonry-row")
                ) || 1;

            const gap =
                Number.parseFloat(
                    styles.getPropertyValue("--masonry-gap")
                ) || 40;

            tiles.forEach((tile) => {
                const height = tile.getBoundingClientRect().height;

                const rowSpan = Math.max(
                    1,
                    Math.ceil((height + gap) / rowSize)
                );

                tile.style.gridRowEnd = `span ${rowSpan}`;
            });
        };

        const scheduleLayoutUpdate = () => {
            if (layoutFrame) {
                cancelAnimationFrame(layoutFrame);
            }

            layoutFrame = requestAnimationFrame(() => {
                layoutFrame = 0;
                updateMasonryLayout();
            });
        };

        const resizeObserver = new ResizeObserver(
            scheduleLayoutUpdate
        );

        tiles.forEach((tile) => {
            resizeObserver.observe(tile);
        });

        scheduleLayoutUpdate();

        document.fonts?.ready.then(scheduleLayoutUpdate);

        if (sortModes.length > 0) {
            const updateButtonDescription = (mode: SortMode) => {
                const description =
                    `${button.dataset.prefix ?? "Sort by"} ${modeLabels[mode]}`;

                button.setAttribute("aria-label", description);
                if (tooltip) {
                    tooltip.textContent = description;
                }
            };

            updateButtonDescription(button.dataset.order as SortMode);

            button.addEventListener("click", () => {
                const current = button.dataset.order as SortMode;
                const currentIndex = sortModes.indexOf(current);
                const next = sortModes[
                (Math.max(0, currentIndex) + 1) % sortModes.length
                    ];

                button.dataset.order = next;

                tiles.sort(comparators[next]);

                tiles.forEach((tile) => {
                    container.appendChild(tile);
                });

                updateButtonDescription(next);
                scheduleLayoutUpdate();
            });
        }
    }
</script>