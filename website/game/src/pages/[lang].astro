---
import { Locale } from "../i18n/translation.ts";
import Forwarding from "../components/forwarding.astro";

// forward /lang to /lang/index
export function getStaticPaths() {
    return Object.values(Locale).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const target = `/${lang}/index`;
---

<Forwarding target={target} canonical data={{ target }}>
    <script>
        const { target } = document.getElementById("redirect")!.dataset;
        window.location.replace(target!);
    </script>
</Forwarding>