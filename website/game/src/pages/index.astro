---
import Layout from "../layouts/base_layout.astro";
import MarkdownRenderer from "../components/markdown.astro";
import ShaderCanvas from "../components/shader_canvas.astro";
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import NoisyFrame from "../components/noisy_frame.astro";
---

<style>
    /* keep centered */
    .page-wrapper {
        display: flex;
        justify-content: center;
    }

    .frame-content-wrapper {
        z-index: 1;
        position: relative;
    }
 </style>

<Layout>
    <ShaderCanvas id="guts"/>

    <div class="page-wrapper">
        <NoisyFrame>
            <div class="frame-content-wrapper">
                <Header />
                <MarkdownRenderer id="test" />
            </div>
        </NoisyFrame>
    </div>
    <Footer author="C. Cords"/>
</Layout>



