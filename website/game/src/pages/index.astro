---
import { Languages } from "../i18n/languages";

const supported = Object.keys(Languages);
const fallback = "en";
const page = "index";
---

<html>
<body data-supported={JSON.stringify(supported)} data-fallback={fallback} data-page={page}>
<noscript>
    <meta http-equiv="refresh" content={`0; url=/${fallback}/${page}`} />
</noscript>

<script>
    const { supported, fallback, page } = document.body.dataset;
    const supportedLangs = JSON.parse(supported);
    const preferred = (navigator.languages || [navigator.language])
        .map((l) => l.toLowerCase().split("-")[0]);
    const lang = preferred.find((l) => supportedLangs.includes(l)) || fallback;
    window.location.replace(`/${lang}/${page}`);
</script>

<a href={`/${fallback}/${page}`}>Redirecting ...</a>

</body>
</html>