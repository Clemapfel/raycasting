---
import { Locale } from "../i18n/translation.ts";
import Forwarding from "../components/forwarding.astro";

const supported = Object.values(Locale);
const fallback = Locale.ENGLISH;
const fallbackPath = `/${fallback}/home`;
---

<Forwarding
        target={fallbackPath}
        data={{ supported: JSON.stringify(supported), fallback }}
>
    <script>
        const { supported, fallback } = document.getElementById("redirect")!.dataset;
        const supportedLangs: string[] = JSON.parse(supported!);

        const resolve = (tag: string): string | undefined => {
            const lower = tag.toLowerCase();
            const base = lower.split("-")[0];
            return [lower, base]
                .map((t) => t)
                .find((t) => supportedLangs.includes(t));
        };

        const preferences = navigator.languages ?? [navigator.language];
        const lang = preferences.map(resolve).find(Boolean) ?? fallback;

        window.location.replace(`/${lang}/home`);
    </script>
</Forwarding>