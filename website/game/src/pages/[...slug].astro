---
import Layout from "../layouts/layout.astro";
import MarkdownRenderer from "../components/markdown.astro";
import ShaderCanvas from "../components/shader_canvas.astro";
import SoftBody from "../components/soft_body.astro";
import Footer from "../components/footer.astro";
import HeaderBar from "../components/header_bar.astro";
import NoisyFrame from "../components/noisy_frame.astro";
import SocialMediaBar from "../components/social_media_bar.astro";
import AnimationStateButton from "../components/animation_state_button.astro";
import BackToTopButton from "../components/back_to_top_button.astro";
import LanguageChooser from "../components/language_chooser.astro";
import BoxLayout from "../components/box_layout.astro";
import Tooltip from "../components/tooltip.astro";
import { Locale, Translation } from "../i18n/translation.ts";

const defaultLanguage = 'en';

const id = Astro.url.pathname.replace(
    new RegExp(`^/(${Object.values(Locale).join('|')})?/?`),
    ''
);

import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
    // generate paths from filenames in /src/content/pages/en
    const entries = await getCollection("pages");
    const slugs = entries.map((entry) => entry.id.replace(/^en\//, "").replace(/\.mdx?$/, ""));
    return Object.values(Locale).flatMap((lang) =>
        slugs.map((slug) => ({
            params: { slug: `${lang}/${slug}` },
            props: { lang, page: slug },
        }))
    );
}

const entry = await getEntry("pages", id);

const locale = Astro.currentLocale ?? Locale.ENGLISH;
const animation_state_text = Translation.animation_state_button[locale];
const back_to_top_text = Translation.back_to_top_button[locale]
---

<style>
    :root {
        --header-overflow: 5vw;
        --outer-margin: 5vw;
        --inner-margin: 8ch;
        --text-width: 120ch;
    }

    .page-layout {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        padding: 0 var(--outer-margin);
        box-sizing: border-box;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: calc(var(--text-width) + (2 * var(--inner-margin)));
    }

    .header-bar-wrapper {
        --header-margin: 20px;
        width: calc(100% + var(--header-overflow));
        margin-top: var(--header-margin);
        margin-bottom: var(--header-margin);
    }

    .noisy-frame-wrapper {
    }

    .social-media-bar-wrapper {
        position: fixed;
        bottom: var(--global-outer-margin);
        left: var(--global-outer-margin);
        max-width: calc(100vw - 2 * var(--outer-margin));
    }

    .global-control-wrapper {
        position: fixed;
        display: flex;
        flex-direction: column;
        gap: var(--global-outer-margin);
        bottom: var(--global-outer-margin);
        right: var(--global-outer-margin);
    }

    .frame-content-wrapper {
        width: 100%;
        height: 2000px;
        max-width: var(--text-width);
        margin: 0 auto;
        box-sizing: border-box;
        padding-left: var(--inner-margin);
        padding-right: var(--inner-margin);
    }

    .footer-wrapper {
        width: 100%;
        max-width: calc(var(--text-width) + (2 * var(--inner-margin)));
        display: flex;
        justify-content: center;
    }

    /* for debugging */
    .center-line {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 1px;
        transform: translateX(-50%);
        background: red;
        pointer-events: none;
        z-index: 9999;
    }
</style>

<Layout title={entry!.data.title}>
    <!-- SoftBody /> -->
    <!-- <div class="center-line"></div> -->
    <div class="page-layout">
        <ShaderCanvas id={entry!.data.shader}/>

        <div class="page-wrapper">
            <div class="header-bar-wrapper">
                <HeaderBar />
            </div>


            <div class="noisy-frame-wrapper">
                <NoisyFrame>
                    <div class="frame-content-wrapper">
                        <MarkdownRenderer collection="pages" id={id} />
                    </div>
                </NoisyFrame>
            </div>

            <div class="social-media-bar-wrapper">
                <SocialMediaBar orientation="vertical" tooltipPosition="right"/>
            </div>

            <div class="global-control-wrapper">
                <BoxLayout orientation="vertical">
                    <Tooltip text={back_to_top_text} position="left">
                        <BackToTopButton />
                    </Tooltip>

                    <Tooltip text={animation_state_text} position="left" >
                        <AnimationStateButton />
                    </Tooltip>
                </BoxLayout>

                <LanguageChooser orientation="vertical" tooltipPosition="left"/>
            </div>
        </div>

        <div class="footer-wrapper">
            <Footer author="C. Cords"/>
        </div>
    </div>
</Layout>