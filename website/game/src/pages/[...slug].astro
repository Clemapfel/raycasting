---
import Layout from "../layouts/layout.astro";
import MarkdownRenderer from "../components/markdown.astro";
import ShaderCanvas from "../components/shader_canvas.astro";
import Footer from "../components/footer.astro";
import HeaderBar from "../components/header_bar.astro";
import NoisyFrame from "../components/noisy_frame.astro";
import LanguageChooser from "../components/language_chooser.astro";
import { Languages } from "../common/languages";

import Orb from "../components/orb.astro";

const defaultLanguage = 'en';

const id = Astro.url.pathname.replace(
    new RegExp(`^/(${Object.keys(Languages).join('|')})?/?`),
    ''
);

import { getCollection, getEntry } from "astro:content";
export async function getStaticPaths() {
    // generate paths from filenames in /src/content/pages/en
    const entries = await getCollection("pages");
    const slugs = entries.map((entry) => entry.id.replace(/^en\//, "").replace(/\.mdx?$/, ""));
    return Object.keys(Languages).flatMap((lang) =>
        slugs.map((slug) => ({
            params: { slug: `${lang}/${slug}` },
            props: { lang, page: slug },
        }))
    );
}

const entry = await getEntry("pages", id);
---

<style>
    :root {
        --header-overflow: 5vw;
        --outer-margin: 5vw;
        --inner-margin: 8ch;
        --text-width: 120ch;
    }

    .page-layout {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        padding: 0 var(--outer-margin);
        box-sizing: border-box;
    }

    .page-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: calc(var(--text-width) + (2 * var(--inner-margin)));
    }

    .header-bar-wrapper {
        --header-margin: 20px;
        width: calc(100% + var(--header-overflow));
        margin-top: var(--header-margin);
        margin-bottom: var(--header-margin);
    }

    .noisy-frame-wrapper {
    }

    .frame-content-wrapper {
        width: 100%;
        max-width: var(--text-width);
        margin: 0 auto;
        box-sizing: border-box;
        padding-left: var(--inner-margin);
        padding-right: var(--inner-margin);
    }

    .footer-wrapper {
        width: 100%;
        max-width: calc(var(--text-width) + (2 * var(--inner-margin)));
        display: flex;
        justify-content: center;
    }

    /* for debugging */
    .center-line {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 1px;
        transform: translateX(-50%);
        background: red;
        pointer-events: none;
        z-index: 9999;
    }
</style>

<Layout title={entry!.data.title}>
    <ShaderCanvas id={entry!.data.shader}/>
    <!-- <div class="center-line"></div> -->
    <div class="page-layout">
        <div class="page-wrapper">
            <div class="header-bar-wrapper">
                <HeaderBar />
            </div>

            <div class="noisy-frame-wrapper">
                <NoisyFrame>
                    <div class="frame-content-wrapper">
                        <MarkdownRenderer collection="pages" id={id} />
                    </div>
                </NoisyFrame>
            </div>
        </div>

        <div class="footer-wrapper">
            <Footer author="C. Cords"/>
        </div>
    </div>
</Layout>