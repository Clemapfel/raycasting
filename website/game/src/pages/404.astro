---
import Layout from "../layouts/layout.astro";
import SDFLabelRenderer from "../components/sdf_label_renderer.astro";
import ShaderCanvas from "../components/shader_canvas.astro";
import Footer from "../components/footer.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sdfPath = `${base}/404.png`;
---

<style>
    .sdf-label-renderer-wrapper {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        pointer-events: none;
    }

    .sdf-label-renderer-wrapper :global(sdf-label-renderer) {
        display: block;
        position: relative;
        width: 100%;
        height: 100%;
    }

    .sdf-label-renderer-wrapper :global(canvas) {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .label {
        font-family: var(--default-font), sans-serif;
        color: var(--default-color-foreground);
        -webkit-text-stroke: 3px var(--default-color-background);
        -webkit-text-fill-color: var(--default-color-foreground);
        paint-order: stroke fill;
        text-align: center;
        font-size: 18pt;
        line-height: 200%;
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        transform: translateY(-50%);
    }

    .label a {
        text-decoration: none;
        cursor: pointer;
    }

    .footer-wrapper {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
    }

    .footer-wrapper :global(footer) {
        margin: 0;
    }
</style>

<Layout title="404">
    <ShaderCanvas id="crystals"/>

    <div class="sdf-label-renderer-wrapper">
        <SDFLabelRenderer path="/404.png"></SDFLabelRenderer>
    </div>

    <div class="label">
        The requested page does not exist.<br>
        Die gesuchte Seite konnte nicht gefunden werden.<br>
        お探しのページは見つかりませんでした。<br>
    </div>

    <div class="footer-wrapper">
        <Footer author="C. Cords"/>
    </div>
</Layout>